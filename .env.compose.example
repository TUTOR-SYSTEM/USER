# ============================================================================
# Database (PostgreSQL)
# ============================================================================
POSTGRES_DB=tutor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tutor_db

# ============================================================================
# Redis (Cache)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ============================================================================
# RabbitMQ (Message Queue)
# ============================================================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672

# ============================================================================
# Gateway Service
# ============================================================================
GATEWAY_PORT=8888
JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_ACCESS_EXPIRES_SECONDS=10800
JWT_REFRESH_EXPIRES_SECONDS=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8888/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
BACKEND_URL=http://localhost:8888

# ============================================================================
# User Service
# ============================================================================
USER_PORT=4001
USER_QUEUE=user_queue

# ============================================================================
# Tutor Service
# ============================================================================
TUTOR_PORT=4002
TUTOR_QUEUE=tutor_queue

# ============================================================================
# Third Service (Email, Upload, Notification, Redis)
# ============================================================================
THIRD_PORT=4003
THIRD_QUEUE=third_queue
GATEWAY_BASE_URL=http://gateway:8888

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=noreply@example.com
PASSWORD_RESET_URL_BASE=http://localhost:3000

# File Upload (Cloudflare R2)
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=tutor
CLOUDFLARE_R2_PUBLIC_URL=https://files.example.com

# ============================================================================
# UI (React)
# ============================================================================
UI_PORT=3000
REACT_APP_API_URL=http://localhost:8888

# ============================================================================
# Environment
# ============================================================================
NODE_ENV=development
